# 容器内定时任务（由 Dockerfile COPY 到 /etc/cron.d/myjobs）
# 注意：/etc/cron.d 下的文件必须 LF 换行、以换行结尾，且第 6 列为用户名（root）
0 */8 * * * root cd /root/apps/news && /bin/bash run.sh >> /data/logs/cron/news.log 2>&1
5 23 * * * root cd /root/apps/iptv && /usr/bin/python3 download_m3u.py >> /data/logs/cron/iptv.log 2>&1
10 23 * * * root cd /root/apps/xueqiu_api && /bin/bash run_xueqiu.sh >> /data/logs/cron/xueqiu.log 2>&1
40 23 * * * root cd /root/apps/eastmoney && /bin/bash run_eastmoney.sh >> /data/logs/cron/eastmoney.log 2>&1
10 9  * * * root cd /root/apps/stock_monitor/scripts && /usr/bin/python3 get_metal_prices_wechat.py >> /data/logs/cron/metal.log 2>&1
